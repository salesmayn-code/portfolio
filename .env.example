# Public URL used for canonical metadata, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# Create this value in Resend and add it to Vercel before enabling contact delivery.
RESEND_API_KEY=re_your_api_key

# A Resend-verified sender. The onboarding address is suitable only for initial testing.
RESEND_FROM_EMAIL=Portfolio Contact <portfolio@your-domain.com>
